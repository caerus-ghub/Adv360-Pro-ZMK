#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&none  &none       &kp ESC   &kp LGUI   &none      &none  &none                                                    &none      &none  &none  &kp RGUI   &kp TAB   &none       &none
&none  &kp Q       &kp W     &kp F      &kp P      &kp B  &none                                                    &none      &none  &kp J  &kp L      &kp U     &kp Y       &none
&none  &kp A       &kp R     &kp S      &kp T      &kp G  &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &none  &kp M  &kp N      &kp E     &kp I       &none
&none  &kp Z       &kp X     &kp C      &kp D      &kp V                       &kp HOME      &kp PG_UP                        &none  &none  &kp H      &kp O     &kp K       &none
&none  &kp LSHIFT  &kp LALT  &kp LCTRL  &kp ENTER         &kp BSPC  &mo 1      &kp END       &kp PG_DN  &mo 2      &kp SPACE         &none  &kp RCTRL  &kp RALT  &kp RSHIFT  &none
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &kp GRAVE  &kp SQT    &kp DOUBLE_QUOTES  &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &kp EQUAL  &kp MINUS  &kp PLUS           &kp ASTERISK  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp LEFT   &kp DOWN   &kp UP             &kp RIGHT     &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans     &kp DOT    &kp COMMA          &kp COLON     &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans     &kp FSLH   &kp BSLH           &kp PIPE      &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2         &kp F3      &kp F4    &kp F5     &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &kp N1         &kp N2      &kp N3    &kp N4     &kp N5  &trans                                      &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &kp BACKSPACE  &kp DELETE  &kp TAB   &kp ENTER  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &kp N6         &kp N7      &kp N8    &kp N9     &kp N0                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &kp LPAR       &kp RPAR    &kp LBRC  &kp RBRC           &trans  &mo 3   &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans    &trans     &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans    &kp LCTRL  &kp AMPS   &kp DLLR   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp DLLR  &kp EXCL   &kp QMARK  &kp TILDE  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans    &kp AT     &kp HASH   &kp SEMI   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans    &trans     &trans     &trans     &trans
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
